# orch8 configuration — all keys optional; the built-in defaults are shown.
# Lookup order: --config FILE, then $ORCH8_CONFIG, then ./orch8.config, then the
# orch8.config next to orch8.sh. Missing file or missing keys => these defaults.

decompose_cmd: /ce-plan       # command the orchestrator runs to produce the units
ship_cmd: /lfg                # command each pane runs per unit: plan -> work -> review -> PR
worker_kind: claude           # herdr agent --kind (claude|codex|omp|gemini|...)
herdr_split_direction: right  # herdr pane split --direction

tiers:                        # tier -> driver model (herdr agent start ... -- --model X)
  hard: opus
  grind: sonnet
  trivial: haiku
